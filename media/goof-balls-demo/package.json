{
  "name": "goof-balls-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx GoofBallsDemo ../../public/goof-balls-demo.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "gif": "remotion ffmpeg -loglevel warning -y -i ../../public/goof-balls-demo.mp4 -t 14 -r 12 -filter_complex \"[0:v]scale=800:450:flags=lanczos,split[a][b];[a]palettegen=max_colors=64:stats_mode=diff[p];[b][p]paletteuse=dither=none:diff_mode=rectangle\" -loop 0 ../../public/goof-balls-demo.gif"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.532"
  }
}
