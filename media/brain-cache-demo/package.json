{
  "name": "brain-cache-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx BrainCacheDemo ../../public/brain-cache-demo.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "gif": "remotion ffmpeg -loglevel warning -y -i ../../public/brain-cache-demo.mp4 -t 12 -r 15 -filter_complex \"[0:v]scale=900:600:flags=lanczos,split[a][b];[a]palettegen=max_colors=128:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=3:diff_mode=rectangle\" -loop 0 ../../public/brain-cache-demo.gif"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.532"
  }
}
